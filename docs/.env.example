# =========================================================================
# PRITHVI-SHIELD - NER Landslide Warning System Environment Configuration
# =========================================================================

# --- APP CONFIGURATION ---
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_prithvi_shield_key_123

# --- DATABASE CONFIGURATION ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prithvi_shield

# --- REDIS CONFIGURATION ---
REDIS_URL=redis://localhost:6379

# --- MICROSERVICE CONNECTIONS ---
ML_SERVICE_URL=http://localhost:8000

# --- MAPBOX & GEOLOCATION (REQUIRED FOR FRONTEND MAP DRAW) ---
# Obtain from: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token_here

# --- WEATHER AND FORECAST SERVICES ---
# Open-Meteo is free and works without a key (integrated as primary).
# OpenWeatherMap API (Secondary/Fallback). Obtain from: https://openweathermap.org/api
OPENWEATHER_API_KEY=placeholder_openweather_key

# --- OFFICAL GOVERNMENT DATA PORTAL ---
# For IMD bulletins and historic datasets. Obtain from: https://data.gov.in/
DATA_GOV_IN_API_KEY=placeholder_data_gov_in_key

# --- COPERNICUS / SATELLITE RADAR ---
# Sentinel Hub OAuth Client. Obtain from: https://www.sentinel-hub.com/explore/
SENTINEL_HUB_CLIENT_ID=placeholder_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=placeholder_sentinel_client_secret

# --- DIGITAL ELEVATION MODEL (DEM) SLOPES ---
# OpenTopography API Key. Obtain from: https://opentopography.org/developers
OPENTOPOGRAPHY_API_KEY=placeholder_opentopography_key

# --- WILDFIRE / THERMAL ANOMALIES (SEISMIC ADJACENT) ---
# NASA FIRMS API. Obtain from: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=placeholder_nasa_firms_key

# --- SMS TELEPHONY GATEWAY (DLT REGISTERED SENDER) ---
# MSG91 is standard in Indian Gov tech. Obtain credentials from: https://msg91.com/
# NOTE: Commercial bulk SMS in India requires DLT (Distributed Ledger Technology) registration.
MSG91_AUTH_KEY=placeholder_msg91_key
MSG91_DLT_TE_ID=placeholder_template_entity_id

# Twilio backup/fallback SMS. Obtain from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_token
TWILIO_PHONE_NUMBER=placeholder_twilio_phone

# --- FIREBASE CLOUD MESSAGING (PUSH ALERTS) ---
# Firebase Admin SDK Credentials (JSON structure stringified)
FIREBASE_SERVICE_ACCOUNT_JSON=placeholder_firebase_creds_json

# --- GOVERNMENT BHASHINI TRANSLATION MISSION ---
# Official translations for regional languages. Obtain from: https://bhashini.gov.in/
BHASHINI_API_KEY=placeholder_bhashini_key
BHASHINI_USER_ID=placeholder_bhashini_user
